---
extends: relaxed

rules:
  line-length: disable
  # We align columns in site.yml / inventory on purpose — it reads as a table.
  commas:
    max-spaces-after: -1
  colons:
    max-spaces-after: -1
  # Required by ansible-lint (keeps --fix available).
  comments:
    min-spaces-from-content: 1
  octal-values:
    forbid-implicit-octal: true    # catches unquoted  mode: 0644
    forbid-explicit-octal: true
