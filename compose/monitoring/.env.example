# With the compose_stack Ansible role, .env is GENERATED from vault vars —
# you don't create it by hand. This just documents the keys.
GRAFANA_ADMIN_PASSWORD=changeme
# SMTP for alert email — Proton Business SMTP submission → misteroni@jchoo.me:
SMTP_HOST=smtp.protonmail.ch:587
SMTP_USER=misteroni@jchoo.me
SMTP_FROM=misteroni@jchoo.me
SMTP_PASSWORD=your-proton-smtp-token
