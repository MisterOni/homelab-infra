# With the compose_stack Ansible role, .env is GENERATED from vault vars —
# you don't create it by hand. This just documents the keys.
GRAFANA_ADMIN_PASSWORD=changeme
# SMTP for alert email (relay via Gmail app password → misteroni@jchoo.me):
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=jocelyn.choo@gmail.com
SMTP_FROM=jocelyn.choo@gmail.com
SMTP_PASSWORD=your-gmail-app-password
