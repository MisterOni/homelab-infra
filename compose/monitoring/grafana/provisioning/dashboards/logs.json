{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "liveNow": true,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["homelab", "logs"],
  "title": "Logs",
  "uid": "homelab-logs",
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(host)",
        "definition": "label_values(host)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({host=~\"$host\"}, container)",
        "definition": "label_values({host=~\"$host\"}, container)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume (lines / 5m by container)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (container) (count_over_time({job=\"docker\", host=~\"$host\", container=~\"$container\"} |~ \"(?i)$search\" [5m]))",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error / fail lines (/ 5m by container)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (container) (count_over_time({job=\"docker\", host=~\"$host\", container=~\"$container\"} |~ \"(?i)(error|fail|panic|fatal)\" [5m]))",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Logs ($host / $container)",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"docker\", host=~\"$host\", container=~\"$container\"} |~ \"(?i)$search\""
        }
      ]
    }
  ]
}
